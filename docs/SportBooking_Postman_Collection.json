{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
		"name": "SportBooking API Collection",
		"description": "Bộ API kiểm thử hoàn chỉnh cho đồ án Đặt Sân Thể Thao (SportBooking)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5290/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{"key": "authEmail", "value": ""},
		{"key": "verifyOtp", "value": ""},
		{"key": "resetOtp", "value": ""},
		{"key": "newPassword", "value": ""},
		{"key": "demoProvider", "value": "Google"},
		{"key": "demoSlug", "value": "google"}
	],
	"item": [
		{
			"name": "1. Xác thực người dùng (Auth)",
			"item": [
				{
					"name": "Xác thực email, đặt lại mật khẩu và đăng nhập demo",
					"description": "Dùng token tài khoản Member chưa xác thực cho hai request đầu. Mã OTP có hiệu lực 15 phút. Trong Development, OTP xuất hiện ở console WebApi, kể cả khi có SMTP. Gán email và mã nhận được vào các biến cục bộ authEmail, verifyOtp, resetOtp và newPassword. Đăng nhập demo chỉ dùng trong Development; demoProvider và demoSlug có thể đổi thành Facebook/facebook hoặc Zalo/zalo.",
					"item": [
						{
							"name": "Gửi mã xác thực email (204)",
							"request": {
								"method": "POST",
								"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
								"url": "{{baseUrl}}/auth/send-verification-email"
							}
						},
						{
							"name": "Xác thực email bằng OTP (204)",
							"request": {
								"method": "POST",
								"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\"otp\":\"{{verifyOtp}}\"}"},
								"url": "{{baseUrl}}/auth/verify-email"
							}
						},
						{
							"name": "Yêu cầu mã đặt lại mật khẩu (204)",
							"request": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\"email\":\"{{authEmail}}\"}"},
								"url": "{{baseUrl}}/auth/forgot-password"
							}
						},
						{
							"name": "Đặt lại mật khẩu bằng OTP (204)",
							"request": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\"email\":\"{{authEmail}}\",\"otp\":\"{{resetOtp}}\",\"newPassword\":\"{{newPassword}}\"}"},
								"url": "{{baseUrl}}/auth/reset-password"
							}
						},
						{
							"name": "Đăng nhập bằng tài khoản demo (200)",
							"request": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\"provider\":\"{{demoProvider}}\",\"email\":\"{{demoSlug}}@sportbooking.invalid\",\"name\":\"{{demoProvider}} Demo\",\"providerKey\":\"demo-{{demoSlug}}\"}"},
								"url": "{{baseUrl}}/auth/external-login"
							}
						}
					]
				},
				{
					"name": "Đăng nhập Admin (Tự động lưu Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"    console.log('Token đã được lưu tự động:', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"nghiaadmin@gmail.com\",\n  \"password\": \"147852369\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Đăng ký thành viên mới",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"khachhang@example.com\",\n  \"givenName\": \"Văn An\",\n  \"surname\": \"Nguyễn\",\n  \"password\": \"MatKhau@123\",\n  \"phone\": \"0987654321\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Đăng nhập User thường (Tự động lưu Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"khachhang@example.com\",\n  \"password\": \"MatKhau@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Xem thông tin cá nhân (Profile)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/member/me",
							"host": ["{{baseUrl}}"],
							"path": ["member", "me"]
						}
					}
				},
				{
					"name": "Đổi mật khẩu",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"MatKhau@123\",\n  \"newPassword\": \"MatKhauMoi@456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "password"]
						}
					}
				},
				{
					"name": "Đăng xuất (Logout)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout"]
						}
					}
				}
			]
		},
